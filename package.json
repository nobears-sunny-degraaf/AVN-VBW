{
	"name": "avn-vbw",
	"type": "module",
	"private": true,
	"workspaces": [
		"layers/*",
		"sites/*"
	],
	"scripts": {
		"dev": "concurrently --names avn,vbw --prefix-colors green,blue --kill-others \"npm:dev:avn\" \"npm:dev:vbw\"",
		"dev:avn": "npm run dev --workspace sites/avn",
		"dev:vbw": "npm run dev --workspace sites/vbw",
		"build:avn": "npm run build --workspace sites/avn",
		"build:vbw": "npm run build --workspace sites/vbw",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"certs": "mkcert -install && mkcert -key-file .certs/localhost-key.pem -cert-file .certs/localhost.pem localhost 127.0.0.1 ::1"
	},
	"overrides": {
		"typescript": "^5.9.3"
	},
	"devDependencies": {
		"concurrently": "^10.0.6"
	}
}
